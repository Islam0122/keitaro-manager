# ---------------------------------------------------------------- required
# Master secret (>= 32 chars). JWT signing and API-key encryption keys are derived from it.
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it invalidates all sessions and makes the stored Keitaro API key unreadable (re-enter it in Settings).
SECRET_KEY=change-me-to-a-long-random-string-of-48-chars

POSTGRES_DB=keitaro_manager
POSTGRES_USER=keitaro
POSTGRES_PASSWORD=change-me-db-password

# ---------------------------------------------------------------- first user
# Created on startup if it does not exist yet (password: >= 10 chars, letters + digits/symbols).
# You can remove these two lines after the first start, or create users with:
#   docker compose exec backend python -m app.cli create-user <name>
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---------------------------------------------------------------- web
APP_PORT=8080
# Only needed if the frontend is served from a different origin than the API.
CORS_ORIGINS=http://localhost:8080
LOG_LEVEL=INFO
ACCESS_TOKEN_TTL_MINUTES=720
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ---------------------------------------------------------------- Keitaro
# Optional: the connection can (and preferably should) be configured on the Settings page,
# where the API key is stored encrypted. These values are a fallback.
KEITARO_API_URL=
KEITARO_API_KEY=
KEITARO_TIMEOUT=15
KEITARO_RETRIES=2
KEITARO_MAX_CONCURRENCY=8
# SSRF protection. Leave false in production.
KEITARO_ALLOW_HTTP=false
KEITARO_ALLOW_PRIVATE_HOSTS=false
